# Copy to /etc/mergen/executor.env, then review it on the host.
# Ownership and mode: root:mergen-executor 0640.
#
# Deliberately contains no VPS address, no token and no network credential.
# The executor works on job directories the dispatcher prepared and has no
# reason to reach the network at all.
#
# A value outside its rules stops the service with exit code 2 and a message
# that names the variable.

# The spool shared with the dispatcher (docs/contracts, GPU spool v1). The
# executor refuses a spool whose root and jobs/ are not owned by the spool
# owner; that account defaults to mergen-dispatcher:
# MERGEN_SPOOL_OWNER=mergen-dispatcher
MERGEN_RUNTIME_ROOT=/var/lib/mergen/runtime
# Executor-only state (0700). The pause file and the GPU lock must live here.
MERGEN_EXECUTOR_STATE=/var/lib/mergen/executor
# Touch this file to stop new jobs from starting without stopping the service.
MERGEN_PAUSE_FILE=/var/lib/mergen/executor/pause
# Advisory lock guarding the single-inference rule. flock target.
MERGEN_GPU_LOCK_PATH=/var/lib/mergen/executor/gpu.lock

# Seconds between spool scans, and between admission attempts while the GPU
# is busy (at most 60, so executor.json stays fresh for the dispatcher).
MERGEN_EXECUTOR_POLL_SECONDS=2
MERGEN_GPU_WAIT_SECONDS=30

# Byte limits; keep them at or below the dispatcher's.
MERGEN_MAX_INPUT_BYTES=2147483648
MERGEN_MAX_EXPANDED_BYTES=8589934592
MERGEN_MAX_RESULT_BYTES=2147483648

# Read by the G4 imaging adapter: the versioned directory containing
# manifest.json and checkpoints (read-only for this account), plus the imaging
# model's own virtual env. Leave the venv blank until a real runner is installed.
MERGEN_MODEL_ROOT=/srv/mergen-models
MERGEN_IMAGING_VENV=
# Hard wall-clock limit for one isolated model process and grace after SIGTERM.
MERGEN_ADAPTER_TIMEOUT_SECONDS=3600
MERGEN_ADAPTER_TERM_GRACE_SECONDS=10
# How long before a failed model preflight is tried again. Preflight opens the
# GPU, so it can fail for a condition that passes; a retry is rate limited
# because each one loads the checkpoint, and waits for the GPU like a job.
MERGEN_PREFLIGHT_RETRY_SECONDS=300

# G4 GPU admission thresholds. Both are required once MERGEN_IMAGING_VENV is
# set. A job waits while another process is using the GPU; a user's process is
# never killed. Blank means an explicit deploy-time decision is still pending.
MERGEN_GPU_MAX_MEMORY_USED_MB=
MERGEN_GPU_MAX_UTILIZATION_PERCENT=
