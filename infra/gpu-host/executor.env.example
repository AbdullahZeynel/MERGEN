# Copy to /etc/mergen/executor.env, then fill the blanks on the host.
# Ownership and mode: root:mergen-executor 0640.
#
# Deliberately contains no VPS address, no token and no network credential.
# The executor runs models against a job directory the dispatcher prepared and
# has no reason to reach the network at all.

# Versioned, checksummed model tree. Read-only for this account.
MERGEN_MODEL_ROOT=/srv/mergen-models
# Job directories prepared by the dispatcher.
MERGEN_RUNTIME_ROOT=/var/lib/mergen/runtime
MERGEN_EXECUTOR_STATE=/var/lib/mergen/executor

# Absolute paths to the two model virtual environments. Kept out of Git.
MERGEN_IMAGING_VENV=

# GPU admission thresholds. A job waits while another process is using the GPU;
# a user's own GPU process is never killed. Leave blank to require an explicit
# decision at deploy time rather than inheriting a guessed number.
MERGEN_GPU_MAX_MEMORY_USED_MB=
MERGEN_GPU_MAX_UTILIZATION_PERCENT=
# Seconds to wait between admission attempts while the GPU is busy.
MERGEN_GPU_WAIT_SECONDS=30
# Advisory lock file guarding the single-job rule. flock target.
MERGEN_GPU_LOCK_PATH=/var/lib/mergen/executor/gpu.lock
# Touch this file to stop new jobs from starting without stopping the service.
MERGEN_PAUSE_FILE=/var/lib/mergen/executor/pause
