# Copy to /etc/mergen/dispatcher.env, then fill the blanks on the host.
# Ownership and mode: root:mergen-dispatcher 0640.
#
# This is the ONLY file on the GPU host that carries VPS coordinates and the
# worker token. The executor must never be able to read it.
#
# Note on systemd: EnvironmentFile is read by PID 1 as root before privileges
# are dropped, so 0640 does not protect the file from systemd. It protects it
# from every other account on this shared computer, including mergen-executor.

# Private Tailscale URL of the VPS control API, port 9100, path prefix
# /internal. Never a public address, never a MagicDNS name.
MERGEN_CONTROL_URL=
# Bearer token shared with MERGEN_CONTROL_TOKEN on the VPS. At least 32
# characters, generated randomly on the host, never committed.
MERGEN_WORKER_TOKEN=
# Sent as the X-Mergen-Worker header. Lowercase letters, digits and hyphens,
# 2-63 characters. Must not encode the machine's real hostname.
MERGEN_WORKER_ID=

# Where the dispatcher stages job input and collects results. Must be outside
# snapshot and backup scope; see check-snapshot-layout.sh.
MERGEN_RUNTIME_ROOT=/var/lib/mergen/runtime
MERGEN_DISPATCHER_STATE=/var/lib/mergen/dispatcher

# Polling and lease behaviour. Seconds.
MERGEN_POLL_INTERVAL_SECONDS=15
MERGEN_LEASE_RENEW_SECONDS=60
MERGEN_REQUEST_TIMEOUT_SECONDS=30

# One heavy inference at a time on a shared desktop.
MERGEN_MAX_CLAIMED_JOBS=1
