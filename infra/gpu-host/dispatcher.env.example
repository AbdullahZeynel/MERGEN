# Copy to /etc/mergen/dispatcher.env, then fill the blanks on the host.
# Ownership and mode: root:mergen-dispatcher 0640.
#
# This is the ONLY file on the GPU host that carries VPS coordinates and the
# worker token. The executor must never be able to read it.
#
# Note on systemd: EnvironmentFile is read by PID 1 as root before privileges
# are dropped, so 0640 does not protect the file from systemd. It protects it
# from every other account on this shared computer, including mergen-executor.
#
# A blank required value stops the service with exit code 2 and a message
# that names the variable; no value is ever printed.

# Origin of the VPS worker control API: scheme, the VPS's private Tailscale
# address and port 9100 -- no path, no query. Plain http is accepted only for
# a Tailscale or loopback address, where WireGuard already protects the token;
# the unit also lets the dispatcher reach nothing else. Never a public address,
# never a MagicDNS name.
MERGEN_CONTROL_URL=
# Bearer token shared with MERGEN_CONTROL_TOKEN on the VPS. At least 32
# printable characters, generated randomly on the host, never committed.
MERGEN_WORKER_TOKEN=
# Sent as the X-Mergen-Worker header. Lowercase letters, digits and hyphens,
# 2-63 characters. Must not encode the machine's real hostname.
MERGEN_WORKER_ID=

# The spool shared with the executor (docs/contracts, GPU spool v1). Must be
# outside snapshot and backup scope; see check-snapshot-layout.sh.
MERGEN_RUNTIME_ROOT=/var/lib/mergen/runtime

# Idle claim interval, lease renewal ceiling and per-request timeout, seconds.
# Renewal also never waits longer than a third of the lease the VPS grants.
MERGEN_POLL_INTERVAL_SECONDS=15
MERGEN_LEASE_RENEW_SECONDS=60
MERGEN_REQUEST_TIMEOUT_SECONDS=30

# Byte limits; keep them at or below the VPS limits in services.env.
MERGEN_MAX_INPUT_BYTES=2147483648
MERGEN_MAX_EXPANDED_BYTES=8589934592
MERGEN_MAX_RESULT_BYTES=2147483648

# One job at a time is fixed by design, on the dispatcher and on the VPS.
