# EXAMPLE ONLY. Review every path on the host; nothing installs or starts this.
#
# Matches the G3 package `mergen_executor`, run from the same release layout
# as the dispatcher:
#
#   /opt/mergen/releases/<version>/src/        backend/archive_io.py,
#                                              backend/live_contracts.py,
#                                              mergen_spool/, mergen_executor/
#   /opt/mergen/releases/<version>/executor/   venv: mergen_executor/requirements.txt
#   /opt/mergen/current -> releases/<version>  one symlink, switched atomically
#
# The executor runs one job at a time on a job directory the dispatcher
# published. It holds no token, knows no VPS address and has no network leg.
# G3 runs no model and opens no GPU device: the NVIDIA device allow-list and
# the imaging model environment arrive with the G4 adapter.

[Unit]
Description=MERGEN GPU model executor
After=local-fs.target

[Service]
Type=simple
User=mergen-executor
Group=mergen-executor
# The spool's setgid group: job files are shared with the dispatcher through it.
SupplementaryGroups=mergen-svc
WorkingDirectory=/var/lib/mergen/executor
EnvironmentFile=/etc/mergen/executor.env
Environment=PYTHONPATH=/opt/mergen/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
# -P: import nothing from the working directory, only from PYTHONPATH and the venv.
ExecStart=/opt/mergen/current/executor/bin/python -P -m mergen_executor
Restart=on-failure
RestartSec=10
# Exit 2 is a configuration or spool-layout refusal: an operator must fix it,
# and a restart would only repeat the same refusal.
RestartPreventExitStatus=2

# Privilege containment
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
# G3 opens no GPU device. G4 replaces this with DevicePolicy=closed and a
# DeviceAllow line for each NVIDIA node the host really has.
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# The owner's processes stay invisible to the service on this shared desktop.
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# G4 revisits this if its CUDA stack needs writable executable memory.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# No network leg at all: an empty network namespace, no IP traffic, and only
# Unix sockets (local account lookups) may be created.
PrivateNetwork=true
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# 0007, not 0077: the spool is a hand-off. Files land 0660 in the setgid
# group mergen-svc so the other service can read them; others get nothing.
UMask=0007
# These bound the whole service, the in-process G3 adapter included; they do
# not separate the adapter from the executor. G4 must confine a real adapter
# to its job's work/output before enabling it (mergen_executor/README.md).
ReadWritePaths=/var/lib/mergen/executor /var/lib/mergen/runtime

# Shared desktop manners. Admission is all-or-nothing and lives in the
# executor (pause file, GPU probe and the flock on MERGEN_GPU_LOCK_PATH),
# because a consumer NVIDIA card has no usable percentage share.
Nice=15
CPUWeight=30
IOWeight=30
MemoryMax=16G

[Install]
WantedBy=multi-user.target
