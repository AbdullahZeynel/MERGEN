# EXAMPLE ONLY until reviewed on the host. stage-services.sh copies it into a
# release and to /etc/systemd/system, but never enables, starts or restarts it.
#
# Matches the G2 package `mergen_dispatcher`, run from a versioned release:
#
#   /opt/mergen/releases/<version>/src/         backend/archive_io.py,
#                                               backend/live_contracts.py,
#                                               mergen_spool/, mergen_dispatcher/
#   /opt/mergen/releases/<version>/dispatcher/  venv: mergen_dispatcher/requirements.txt
#   /opt/mergen/current -> releases/<version>   one symlink, switched atomically
#
# The dispatcher is the only MERGEN unit that talks to the VPS. It holds the
# worker token, claims jobs, downloads input and uploads results. It runs no
# model, starts no subprocess and opens no GPU device.

[Unit]
Description=MERGEN GPU job dispatcher
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=mergen-dispatcher
Group=mergen-dispatcher
# The spool's setgid group: job files reach the executor through it.
SupplementaryGroups=mergen-svc
WorkingDirectory=/var/lib/mergen/dispatcher
EnvironmentFile=/etc/mergen/dispatcher.env
Environment=PYTHONPATH=/opt/mergen/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
# -P: import nothing from the working directory, only from PYTHONPATH and the venv.
ExecStart=/opt/mergen/current/dispatcher/bin/python -P -m mergen_dispatcher
Restart=on-failure
RestartSec=10
# Exit 2 is a configuration or spool-layout refusal: an operator must fix it,
# and a restart would only repeat the same refusal.
RestartPreventExitStatus=2

# Privilege containment
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
# No /dev/nvidia*: the dispatcher never touches the GPU.
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The control API is reached over Tailscale only; the token cannot go anywhere else.
IPAddressDeny=any
IPAddressAllow=localhost 100.64.0.0/10 fd7a:115c:a1e0::/48
# 0007, not 0077: the spool is a hand-off. Files land 0660 in the setgid
# group mergen-svc so the other service can read them; others get nothing.
UMask=0007
ReadWritePaths=/var/lib/mergen/dispatcher /var/lib/mergen/runtime

# Shared desktop manners: the owner's interactive work outranks batch work.
Nice=10
CPUWeight=40
IOWeight=40
# Transfers stream in 1 MiB chunks; no payload is held in memory.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
