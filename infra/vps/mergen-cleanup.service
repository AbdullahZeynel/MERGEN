[Unit]
Description=Remove expired MERGEN live sessions and recover stale jobs

[Service]
Type=oneshot
User=mergen
Group=mergen
WorkingDirectory=/srv/mergen/services
EnvironmentFile=/etc/mergen/services.env
# Module form: only -m puts WorkingDirectory on sys.path, where `backend` lives.
ExecStart=/srv/mergen/services/.venv/bin/python -m backend.cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mergen/runtime
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
