# Copy to /etc/mergen/services.env; systemd loads it explicitly.
# Absolute path to the prepared version-2 package on this VPS.
MERGEN_DEMO_ROOT=
# Optional private loopback URL; blank is invalid, so omit if using default.
# MERGEN_MCP_URL=http://127.0.0.1:9010/mcp

# Live-session control plane. Runtime content must not be backed up.
MERGEN_RUNTIME_ROOT=/srv/mergen/runtime
MERGEN_DATABASE_PATH=/srv/mergen/runtime/control.sqlite3
MERGEN_MAX_ACTIVE_SESSIONS=10
MERGEN_SESSION_IDLE_SECONDS=180
MERGEN_SESSION_MAX_SECONDS=1800
MERGEN_WORKER_LEASE_SECONDS=180
MERGEN_JOB_MAX_ATTEMPTS=3
MERGEN_MAX_CLAIMED_JOBS=1
MERGEN_MAX_UPLOAD_BYTES=2147483648
MERGEN_MAX_EXPANDED_BYTES=8589934592
MERGEN_MAX_RESULT_BYTES=2147483648
MERGEN_COOKIE_SECURE=true

# SHA-256 of the presentation access code. Store only the hash here; the access
# code is entered by the user and must never be bundled into the frontend.
MERGEN_LIVE_ACCESS_HASH=

# Required before starting mergen-control. Use this VPS node's private Tailscale
# address and a randomly generated secret of at least 32 characters. Never commit
# their real values.
MERGEN_CONTROL_HOST=
MERGEN_CONTROL_TOKEN=
