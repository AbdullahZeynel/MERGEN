[Unit]
Description=MERGEN demo API gateway
After=network.target mergen-mcp.service
Wants=mergen-mcp.service

[Service]
User=mergen
Group=mergen
WorkingDirectory=/srv/mergen/services
EnvironmentFile=/etc/mergen/services.env
ExecStart=/srv/mergen/services/.venv/bin/python -m uvicorn backend.api:app --host 127.0.0.1 --port 9000 --limit-concurrency 40 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
