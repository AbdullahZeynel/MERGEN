[Unit]
Description=MERGEN private GPU worker control API
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=mergen
Group=mergen
WorkingDirectory=/srv/mergen/services
EnvironmentFile=/etc/mergen/services.env
# Module form: only -m puts WorkingDirectory on sys.path, where `backend` lives.
ExecStart=/srv/mergen/services/.venv/bin/python -m backend.run_control
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mergen/runtime
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
