[Unit]
Description=MERGEN private GPU worker control API
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=mergen
Group=mergen
WorkingDirectory=/srv/mergen/services
EnvironmentFile=/etc/mergen/services.env
ExecStart=/srv/mergen/services/.venv/bin/python /srv/mergen/services/backend/run_control.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mergen/runtime
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
