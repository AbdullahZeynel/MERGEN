# Copy into the server's Caddy configuration after setting MERGEN_DOMAIN.
# Real domain/host values belong in the server's local environment only.
{$MERGEN_DOMAIN} {
	root * {$MERGEN_ROOT:/srv/mergen}/current
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Cache-Control "no-cache"
	}
	handle /api/* {
		# F4: replace with the private backend reverse_proxy after integration.
		respond "API is not connected" 503
	}
	handle /assets/* {
		root * {$MERGEN_ROOT:/srv/mergen}/shared
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /demo/* {
		# Missing data must be a 404, never the SPA's index.html.
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
